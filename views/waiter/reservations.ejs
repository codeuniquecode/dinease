<%- include('../partials/head', { title: 'Reservations', pageStyle: 'waiter' }) %>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/waiterSidebar', { activePage: 'reservations' }) %>

<div class="main-content">
    <div class="page-header">
        <h1 class="page-title">Reservations</h1>
        <span style="font-size:13px;color:var(--text-muted);">
            <%= reservations.length %> total &nbsp;·&nbsp;
            <i class="bi bi-info-circle me-1"></i>Contact admin to confirm or cancel reservations
        </span>
    </div>
    <div class="page-body">

        <!-- Today highlight -->
        <% const today = new Date().toDateString();
           const todayRes = reservations.filter(r =>
               new Date(r.reservationDate).toDateString() === today && r.status !== 'cancelled'
           ); %>
        <% if (todayRes.length > 0) { %>
        <div style="background:#EBF5FB;border:1.5px solid #2980B9;border-radius:10px;padding:14px 18px;margin-bottom:20px;">
            <div style="font-weight:600;color:#1A6B8A;margin-bottom:6px;">
                <i class="bi bi-calendar-event-fill me-2"></i><%= todayRes.length %> reservation(s) today
            </div>
            <div style="font-size:13px;color:#555;">
                <% todayRes.forEach(r => { %>
                <span style="margin-right:16px;">
                    👥 <%= r.partySize %>p &nbsp;·&nbsp;
                    Table <%= r.table?.tableNumber %> &nbsp;·&nbsp;
                    <%= r.timeSlot %>
                    <span class="status-badge status-<%= r.status %>" style="margin-left:4px;"><%= r.status %></span>
                </span>
                <% }) %>
            </div>
        </div>
        <% } %>

        <div class="card">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr>
                        <th>Customer</th>
                        <th>Table</th>
                        <th>Party</th>
                        <th>Date</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th>Special Requests</th>
                    </tr></thead>
                    <tbody>
                        <% if (reservations.length === 0) { %>
                        <tr>
                            <td colspan="7" style="text-align:center;padding:32px;color:var(--text-muted);">
                                No reservations found
                            </td>
                        </tr>
                        <% } %>
                        <% reservations.forEach(res => { %>
                        <tr style="<%= new Date(res.reservationDate).toDateString() === today ? 'background:#FAFFF8;' : '' %>">
                            <td>
                                <div style="font-weight:600;"><%= res.customer?.name || '—' %></div>
                                <div style="font-size:11px;color:var(--text-muted);">
                                    <%= res.customer?.phone || res.customer?.email || '' %>
                                </div>
                            </td>
                            <td>
                                Table <%= res.table?.tableNumber %>
                                <div style="font-size:11px;color:var(--text-muted);">
                                    <%= res.table?.capacity %>p · <%= res.table?.location %>
                                </div>
                            </td>
                            <td style="font-weight:600;"><%= res.partySize %> guests</td>
                            <td style="font-size:13px;">
                                <%= new Date(res.reservationDate).toLocaleDateString('en-NP',{month:'short',day:'numeric',year:'numeric'}) %>
                            </td>
                            <td style="font-size:13px;"><%= res.timeSlot %></td>
                            <td>
                                <span class="status-badge status-<%= res.status %>"><%= res.status %></span>
                            </td>
                            <td style="font-size:12px;color:var(--text-muted);max-width:160px;">
                                <%= res.specialRequests || '—' %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <div style="margin-top:16px;padding:12px 16px;background:var(--primary-light);border-radius:8px;font-size:12px;color:var(--primary-dark);">
            <i class="bi bi-shield-lock-fill me-2"></i>
            <strong>Admin only:</strong> Reservation confirmation and cancellation is managed by the admin panel at <a href="/admin/dashboard" style="color:var(--primary-dark);font-weight:600;">/admin/dashboard</a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
