<%- include('../partials/head', { title: 'Bill — ' + order.orderNumber, pageStyle: 'waiter' }) %>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/waiterSidebar', { activePage: 'dashboard' }) %>

<div class="main-content">
    <div class="page-header">
        <div>
            <h1 class="page-title">Bill — <%= order.orderNumber %></h1>
            <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">
                Table <%= order.table?.tableNumber %>
                &nbsp;·&nbsp; Status: <span class="status-badge status-<%= order.status %>"><%= order.status %></span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/order/invoice/<%= order._id %>" class="btn-outline-custom" target="_blank">
                <i class="bi bi-file-pdf me-1"></i>PDF Receipt
            </a>
            <a href="/waiter/dashboard" class="btn-outline-custom">
                <i class="bi bi-arrow-left me-1"></i>Dashboard
            </a>
        </div>
    </div>

    <div class="page-body" style="max-width:620px;">

        <!-- Receipt -->
        <div class="card bill-card mb-4">
            <div class="card-body p-0">
                <div class="bill-header">
                    <div style="font-family:'Playfair Display',serif;font-size:26px;font-weight:700;color:var(--primary);">🍽 DineEase</div>
                    <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">Restaurant Management System</div>
                    <div style="margin-top:12px;font-size:13px;">
                        Table <strong><%= order.table?.tableNumber %></strong>
                        &nbsp;·&nbsp; <strong><%= order.orderNumber %></strong>
                        <% if (order.customer) { %>&nbsp;·&nbsp; <%= order.customer.name %><% } %>
                    </div>
                    <div style="font-size:12px;color:var(--text-muted);margin-top:3px;">
                        <%= new Date(order.placedAt).toLocaleString('en-NP',{dateStyle:'medium',timeStyle:'short'}) %>
                    </div>
                </div>

                <div style="padding:16px 28px;">
                    <table class="bill-items-table" style="width:100%;font-size:13px;border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th style="text-align:left;">Item</th>
                                <th style="text-align:center;">Qty</th>
                                <th style="text-align:right;">Rate</th>
                                <th style="text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% order.items.forEach(item => { %>
                            <tr>
                                <td style="padding:7px 0;">
                                    <div style="font-weight:500;"><%= item.name %></div>
                                    <% if (item.specialNote) { %><div style="font-size:11px;color:var(--primary);font-style:italic;">📝 <%= item.specialNote %></div><% } %>
                                </td>
                                <td style="text-align:center;"><%= item.quantity %></td>
                                <td style="text-align:right;color:var(--text-muted);">Rs. <%= item.price %></td>
                                <td style="text-align:right;font-weight:600;">Rs. <%= (item.price*item.quantity).toFixed(2) %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div style="padding:0 28px 16px;border-bottom:1px dashed var(--border);">
                    <div class="d-flex justify-content-between mb-1" style="font-size:13px;">
                        <span style="color:var(--text-muted);">Subtotal</span>
                        <span>Rs. <%= order.subtotal.toFixed(2) %></span>
                    </div>
                    <% if (discountResult.breakdown.loyaltyApplied) { %>
                    <div class="d-flex justify-content-between mb-1 discount-line" style="font-size:13px;">
                        <span><i class="bi bi-heart-fill me-1"></i>Loyalty (5%)</span>
                        <span>− Rs. <%= discountResult.breakdown.loyaltySaving.toFixed(2) %></span>
                    </div>
                    <% } %>
                    <% if (discountResult.breakdown.comboApplied) { %>
                    <div class="d-flex justify-content-between mb-1 discount-line" style="font-size:13px;">
                        <span><i class="bi bi-collection-fill me-1"></i>Combo (10%)</span>
                        <span>− Rs. <%= discountResult.breakdown.comboSaving.toFixed(2) %></span>
                    </div>
                    <% } %>
                    <% if (discountResult.breakdown.happyHourApplied) { %>
                    <div class="d-flex justify-content-between mb-1 discount-line" style="font-size:13px;">
                        <span><i class="bi bi-sun-fill me-1"></i>Happy Hour (15%)</span>
                        <span>− Rs. <%= discountResult.breakdown.happyHourSaving.toFixed(2) %></span>
                    </div>
                    <% } %>
                    <% if (discountResult.discountAmount > 0) { %>
                    <div class="d-flex justify-content-between mb-1" style="font-size:13px;font-weight:600;color:#27AE60;">
                        <span>Total Savings</span><span>− Rs. <%= discountResult.discountAmount.toFixed(2) %></span>
                    </div>
                    <% } %>
                    <div class="d-flex justify-content-between" style="font-size:13px;">
                        <span style="color:var(--text-muted);">VAT (<%= vatRate %>%)</span>
                        <span>Rs. <%= vatAmount.toFixed(2) %></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center" style="padding:16px 28px;">
                    <span style="font-size:18px;font-weight:700;">TOTAL</span>
                    <span style="font-size:24px;font-weight:700;font-family:'Playfair Display',serif;color:var(--primary);">
                        Rs. <%= totalAmount.toFixed(2) %>
                    </span>
                </div>
            </div>
        </div>

        <!-- ===== PAYMENT ===== -->
        <% if (!order.isPaid) { %>

        <!-- Cash payment only for waiter -->
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-cash-coin me-2" style="color:var(--primary);"></i>Cash Payment
            </div>
            <div class="card-body p-4">
                <p style="font-size:13px;color:var(--text-muted);margin-bottom:14px;">
                    Customer pays cash at the table.
                </p>
                <form action="/order/<%= order._id %>/pay" method="POST">
                    <input type="hidden" name="paymentMethod" value="cash">
                    <button type="submit" class="btn-primary-custom w-100" style="padding:12px;font-size:14px;">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Confirm Cash Payment — Rs. <%= totalAmount.toFixed(2) %>
                    </button>
                </form>
            </div>
        </div>

        <!-- eSewa digital payment option -->
        <div class="card mb-4" style="border-color:#60BB46;">
            <div class="card-header" style="background:#F0FBF0;border-color:#C3E6C3;">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:26px;height:26px;background:#60BB46;border-radius:6px;display:flex;align-items:center;justify-content:center;color:white;font-weight:900;font-size:13px;">e</div>
                    <span style="font-weight:600;">eSewa Digital Payment</span>
                    <% if (order.customer) { %>
                    <span style="margin-left:auto;font-size:12px;color:#2D6A2D;font-weight:500;"><%= order.customer.name %></span>
                    <% } %>
                </div>
            </div>
            <div class="card-body p-3">
                <% if (order.customer) { %>
                <p style="font-size:13px;color:var(--text-muted);margin:0;">
                    Customer can pay via eSewa from their <strong>My Orders</strong> page.
                </p>
                <% } else { %>
                <p style="font-size:13px;color:var(--text-muted);margin:0;">
                    No linked customer account. Please collect <strong>cash</strong>.
                </p>
                <% } %>
            </div>
        </div>

        <% } else { %>
        <!-- Paid -->
        <div class="card" style="background:#EAFAF1;border-color:#27AE60;">
            <div class="card-body p-4 text-center">
                <i class="bi bi-check-circle-fill" style="font-size:36px;color:#27AE60;display:block;margin-bottom:10px;"></i>
                <div style="font-size:16px;font-weight:700;color:#1E8449;margin-bottom:4px;">Payment Completed</div>
                <div style="font-size:13px;color:#555;">
                    Rs. <%= order.totalAmount.toFixed(2) %> paid via
                    <strong><%= order.paymentMethod?.toUpperCase() %></strong>
                </div>
                <a href="/order/receipt/<%= order._id %>" class="btn-primary-custom" style="text-decoration:none;margin-top:16px;display:inline-block;">
                    <i class="bi bi-receipt me-2"></i>View Receipt
                </a>
            </div>
        </div>
        <% } %>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
