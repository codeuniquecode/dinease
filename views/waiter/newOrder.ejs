<%- include('../partials/head', { title: 'New Order', pageStyle: 'waiter' }) %>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/waiterSidebar', { activePage: 'newOrder' }) %>

<div class="main-content">
    <div class="page-header">
        <h1 class="page-title">Place New Order</h1>
        <a href="/waiter/dashboard" class="btn-outline-custom">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
    <div class="page-body">
        <div class="row g-4">

            <!-- LEFT: Table + Menu -->
            <div class="col-lg-8">

                <!-- Table Selection -->
                <div class="card mb-4">
                    <div class="card-header">1. Select Table</div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-wrap gap-2">
                            <% tables.forEach(table => { %>
                            <button type="button"
                                class="table-floor-btn <%= table.status %>"
                                data-table-id="<%= table._id %>"
                                onclick="selectTable('<%= table._id %>', '<%= table.tableNumber %>')"
                                <%= table.status === 'maintenance' ? 'disabled' : '' %>>
                                <div>T-<%= table.tableNumber %></div>
                                <div style="font-size:10px;font-weight:400;"><%= table.capacity %>p</div>
                                <div style="font-size:9px;opacity:0.7;"><%= table.location %></div>
                            </button>
                            <% }) %>
                        </div>
                        <div id="selectedTableInfo" style="display:none;margin-top:12px;padding:8px 14px;background:var(--primary-light);border-radius:8px;font-size:13px;color:var(--primary-dark);font-weight:600;">
                            <i class="bi bi-check-circle-fill me-2"></i>Table <span id="selectedTableNum"></span> selected
                        </div>
                    </div>
                </div>

                <!-- Menu -->
                <div class="card">
                    <div class="card-header">
                        2. Select Items
                        <ul class="nav nav-tabs card-header-tabs mt-2" id="categoryTabs">
                            <li class="nav-item">
                                <a class="nav-link active" onclick="filterMenu('all',this)" style="cursor:pointer;">All</a>
                            </li>
                            <% Object.keys(menuByCategory).forEach(cat => { %>
                            <li class="nav-item">
                                <a class="nav-link" onclick="filterMenu('<%= cat %>',this)" style="cursor:pointer;"><%= cat %></a>
                            </li>
                            <% }) %>
                        </ul>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3" id="menuGrid">
                            <% Object.entries(menuByCategory).forEach(([cat, items]) => { %>
                            <% items.forEach(item => { %>
                            <div class="col-sm-6 col-lg-4 menu-item-card" data-category="<%= cat %>">
                                <div class="card menu-item-tile h-100"
                                    onclick="addToCart('<%= item._id %>','<%= item.name.replace(/'/g, `\\'`) %>',<%= item.price %>,'<%= cat %>')">
                                    <div class="card-body p-3">
                                        <!-- <div style="font-size:22px;margin-bottom:4px;">
                                            <% const emojis = {Appetizer:'🥟','Main Course':'🍛',Dessert:'🍮',Beverage:'☕',Snacks:'🥨',Special:'⭐'}; %>
                                            <%= emojis[cat] || '🍽' %>
                                        </div> -->
                                        <!-- NEW -->
<div style="width:100%;height:80px;border-radius:8px;overflow:hidden;margin-bottom:6px;background:#2D2D2D;display:flex;align-items:center;justify-content:center;">
    <% if (item.image && item.image !== 'default-food.jpg') { %>
    <img src="/storage/<%= item.image %>"
         alt="<%= item.name %>"
         style="width:100%;height:80px;object-fit:cover;">
    <% } else { %>
    <% const emojis = {Appetizer:'🥟','Main Course':'🍛',Dessert:'🍮',Beverage:'☕',Snacks:'🥨',Special:'⭐'}; %>
    <span style="font-size:24px;"><%= emojis[cat] || '🍽' %></span>
    <% } %>
</div>
                                        <div style="font-size:13px;font-weight:600;"><%= item.name %></div>
                                        <div style="font-size:11px;color:var(--text-muted);margin:2px 0 6px;">
                                            <%= item.category %> · ⏱<%= item.preparationTime %>min
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span style="color:var(--primary);font-weight:700;font-size:14px;">Rs. <%= item.price %></span>
                                            <span style="background:var(--primary);color:white;border-radius:20px;padding:2px 10px;font-size:11px;">+ Add</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: Cart -->
            <div class="col-lg-4">
                <div class="card" style="position:sticky;top:20px;">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Order Cart</span>
                        <span class="badge" style="background:var(--primary);color:white;" id="cartCount">0 items</span>
                    </div>
                    <div id="cartItems" style="max-height:350px;overflow-y:auto;">
                        <div id="emptyCart" class="cart-empty">
                            <i class="bi bi-cart3" style="font-size:32px;display:block;margin-bottom:8px;color:var(--border);"></i>
                            No items added yet
                        </div>
                    </div>
                    <div class="card-footer" style="background:transparent;">
                        <div class="d-flex justify-content-between mb-2" style="font-size:14px;">
                            <span>Subtotal</span>
                            <span id="cartSubtotal" style="font-weight:700;color:var(--primary);">Rs. 0</span>
                        </div>
                        <form id="orderForm" action="/order/place" method="POST">
                            <input type="hidden" name="tableId" id="formTableId">
                            <input type="hidden" name="isQROrder" value="false">
                            <div id="cartInputs"></div>
                            <button type="submit" id="placeBtn" class="btn-primary-custom w-100 mt-2">
                                <i class="bi bi-send-fill me-2"></i>Place Order
                            </button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
// FIX: use a different JS variable name to avoid conflict with EJS template variable
let activeTableId = null;
let cart = {};

// Pre-select table if passed via query string
// Use a JS constant from EJS to avoid variable name collision
const preselectedTableId = '<%= selectedTableId || "" %>';
if (preselectedTableId) {
    // Run after DOM is ready
    window.addEventListener('DOMContentLoaded', () => {
        const btn = document.querySelector(`[data-table-id="${preselectedTableId}"]`);
        if (btn) {
            const num = btn.querySelector('div:first-child').textContent.replace('T-', '');
            selectTable(preselectedTableId, num);
        }
    });
}

function selectTable(id, num) {
    activeTableId = id;
    document.getElementById('formTableId').value = id;
    document.getElementById('selectedTableNum').textContent = num;
    document.getElementById('selectedTableInfo').style.display = 'block';
    // Highlight selected
    document.querySelectorAll('.table-floor-btn').forEach(b => {
        b.style.outline = b.dataset.tableId === id ? '3px solid var(--primary)' : 'none';
    });
    checkPlaceBtn();
}

function addToCart(id, name, price, category) {
    if (cart[id]) cart[id].quantity++;
    else cart[id] = { id, name, price, quantity: 1, category, specialNote: '' };
    renderCart();
}

function removeFromCart(id) {
    if (cart[id]) {
        cart[id].quantity--;
        if (cart[id].quantity <= 0) delete cart[id];
    }
    renderCart();
}

function renderCart() {
    const items = Object.values(cart);
    document.getElementById('emptyCart').style.display = items.length === 0 ? 'block' : 'none';

    let subtotal = 0;
    let html = '';
    let inputs = '';

    items.forEach((item, i) => {
        subtotal += item.price * item.quantity;
        html += `
        <div style="padding:10px 14px;border-bottom:1px solid var(--border);">
            <div class="d-flex justify-content-between align-items-start">
                <div style="flex:1;">
                    <div style="font-size:13px;font-weight:600;">${item.name}</div>
                    <div style="font-size:11px;color:var(--text-muted);">Rs. ${item.price} each</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" data-action="minus" data-id="${item.id}"
                        style="background:#EEE;border:none;width:24px;height:24px;border-radius:50%;cursor:pointer;font-size:15px;line-height:1;">−</button>
                    <span style="font-weight:700;min-width:18px;text-align:center;">${item.quantity}</span>
                    <button type="button" data-action="plus" data-id="${item.id}"
                        style="background:var(--primary);color:white;border:none;width:24px;height:24px;border-radius:50%;cursor:pointer;font-size:15px;line-height:1;">+</button>
                </div>
            </div>
            <input type="text" placeholder="Special note (optional)"
                style="margin-top:6px;width:100%;font-size:11px;padding:4px 8px;border:1px solid var(--border);border-radius:6px;"
                data-note-id="${item.id}"
                value="${item.specialNote}">
        </div>`;

        inputs += `<input type="hidden" name="items[${i}][menuItemId]" value="${item.id}">
                   <input type="hidden" name="items[${i}][quantity]" value="${item.quantity}">
                   <input type="hidden" name="items[${i}][specialNote]" value="${item.specialNote}">`;
    });

    if (items.length > 0) {
        document.getElementById('cartItems').innerHTML = html + `<div id="emptyCart" class="cart-empty" style="display:none;"></div>`;
    }
    document.getElementById('cartSubtotal').textContent = 'Rs. ' + subtotal;
    document.getElementById('cartCount').textContent = items.length + ' item' + (items.length !== 1 ? 's' : '');
    document.getElementById('cartInputs').innerHTML = inputs;
    checkPlaceBtn();

    // Attach delegated events after re-render
    document.getElementById('cartItems').querySelectorAll('[data-action]').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.dataset.id;
            if (btn.dataset.action === 'plus')  { if(cart[id]) cart[id].quantity++; renderCart(); }
            if (btn.dataset.action === 'minus') { removeFromCart(id); }
        });
    });
    document.getElementById('cartItems').querySelectorAll('[data-note-id]').forEach(inp => {
        inp.addEventListener('change', () => {
            if (cart[inp.dataset.noteId]) {
                cart[inp.dataset.noteId].specialNote = inp.value;
                rebuildInputs();
            }
        });
    });
}

function rebuildInputs() {
    let inputs = '';
    Object.values(cart).forEach((item, i) => {
        inputs += `<input type="hidden" name="items[${i}][menuItemId]" value="${item.id}">
                   <input type="hidden" name="items[${i}][quantity]" value="${item.quantity}">
                   <input type="hidden" name="items[${i}][specialNote]" value="${item.specialNote}">`;
    });
    document.getElementById('cartInputs').innerHTML = inputs;
}

function checkPlaceBtn() {
    const hasItems = Object.keys(cart).length > 0;
    const hasTable = !!activeTableId;
    document.getElementById('placeBtn').disabled = !(hasItems && hasTable);
}

function filterMenu(cat, el) {
    document.querySelectorAll('.menu-item-card').forEach(card => {
        card.style.display = (cat === 'all' || card.dataset.category === cat) ? '' : 'none';
    });
    document.querySelectorAll('#categoryTabs .nav-link').forEach(a => a.classList.remove('active'));
    el.classList.add('active');
}
</script>
</body></html>
