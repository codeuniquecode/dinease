<%- include('../partials/head', { title: 'Receipt' }) %>
<body style="background:var(--bg);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;">
<%- include('../partials/flash') %>

<div style="max-width:480px;width:100%;">
    <div class="card" style="border-radius:20px;">
        <div class="card-body p-0">

            <!-- Header -->
            <div style="text-align:center;padding:32px 28px 20px;border-bottom:1px dashed var(--border);">
                <div style="font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:var(--primary);">
                    🍽 DineEase
                </div>
                <div style="font-size:11px;color:var(--text-muted);letter-spacing:1px;text-transform:uppercase;margin-top:4px;">
                    Official Receipt
                </div>
                <div style="width:64px;height:64px;background:#EAFAF1;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:16px auto 8px;">
                    <i class="bi bi-check-lg" style="font-size:30px;color:#27AE60;"></i>
                </div>
                <div style="font-size:13px;color:var(--text-muted);">Payment Successful</div>
            </div>

            <!-- Info -->
            <div style="padding:16px 28px;border-bottom:1px dashed var(--border);">
                <div class="d-flex justify-content-between mb-2" style="font-size:13px;">
                    <span style="color:var(--text-muted);">Order Number</span>
                    <strong><%= order.orderNumber %></strong>
                </div>
                <div class="d-flex justify-content-between mb-2" style="font-size:13px;">
                    <span style="color:var(--text-muted);">Table</span>
                    <span>Table <%= order.table?.tableNumber %></span>
                </div>
                <% if (order.customer) { %>
                <div class="d-flex justify-content-between mb-2" style="font-size:13px;">
                    <span style="color:var(--text-muted);">Customer</span>
                    <span><%= order.customer.name %></span>
                </div>
                <% } %>
                <div class="d-flex justify-content-between mb-2" style="font-size:13px;">
                    <span style="color:var(--text-muted);">Date & Time</span>
                    <span><%= new Date(order.completedAt || order.placedAt).toLocaleString('en-NP',{dateStyle:'medium',timeStyle:'short'}) %></span>
                </div>
                <div class="d-flex justify-content-between" style="font-size:13px;">
                    <span style="color:var(--text-muted);">Payment Method</span>
                    <span style="font-weight:700;text-transform:uppercase;color:<%= order.paymentMethod==='esewa'?'#60BB46':order.paymentMethod==='card'?'#2980B9':'var(--text)' %>;">
                        <% if (order.paymentMethod === 'esewa') { %>
                        <span style="background:#60BB46;color:white;padding:2px 8px;border-radius:4px;font-size:12px;">eSewa</span>
                        <% } else if (order.paymentMethod === 'card') { %>
                        💳 Card
                        <% } else { %>
                        💵 Cash
                        <% } %>
                    </span>
                </div>
            </div>

            <!-- Items summary -->
            <div style="padding:16px 28px;border-bottom:1px dashed var(--border);">
                <% order.items.forEach(item => { %>
                <div class="d-flex justify-content-between mb-1" style="font-size:13px;">
                    <span><%= item.name %> × <%= item.quantity %></span>
                    <span>Rs. <%= (item.price * item.quantity).toFixed(2) %></span>
                </div>
                <% }) %>
            </div>

            <!-- Totals -->
            <div style="padding:12px 28px;border-bottom:1px dashed var(--border);">
                <div class="d-flex justify-content-between mb-1" style="font-size:13px;">
                    <span style="color:var(--text-muted);">Subtotal</span>
                    <span>Rs. <%= order.subtotal.toFixed(2) %></span>
                </div>
                <% if (order.discountAmount > 0) { %>
                <div class="d-flex justify-content-between mb-1" style="font-size:13px;color:#27AE60;">
                    <span>Discount</span>
                    <span>− Rs. <%= order.discountAmount.toFixed(2) %></span>
                </div>
                <% } %>
                <div class="d-flex justify-content-between" style="font-size:13px;">
                    <span style="color:var(--text-muted);">VAT (<%= vatRate %>%)</span>
                    <span>Rs. <%= order.vatAmount.toFixed(2) %></span>
                </div>
            </div>

            <!-- Grand Total -->
            <div class="d-flex justify-content-between align-items-center" style="padding:20px 28px;border-bottom:1px dashed var(--border);">
                <span style="font-size:18px;font-weight:700;">TOTAL PAID</span>
                <span style="font-size:26px;font-weight:700;font-family:'Playfair Display',serif;color:var(--primary);">
                    Rs. <%= order.totalAmount.toFixed(2) %>
                </span>
            </div>

            <!-- Actions -->
            <div style="padding:20px 28px;display:flex;gap:10px;">
                <a href="/order/invoice/<%= order._id %>"
                    class="btn-outline-custom" style="flex:1;text-align:center;text-decoration:none;" target="_blank">
                    <i class="bi bi-file-pdf me-1"></i>PDF
                </a>
                <a href="/waiter/dashboard"
                    class="btn-primary-custom" style="flex:2;text-align:center;text-decoration:none;">
                    <i class="bi bi-grid me-1"></i>Back to Dashboard
                </a>
            </div>

            <div style="text-align:center;padding:0 28px 20px;font-size:12px;color:var(--text-muted);">
                Thank you for dining with DineEase! 🙏
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
