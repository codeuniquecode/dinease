<%- include('../partials/head', { title: 'Pay with eSewa', pageStyle: 'customer' }) %>
<body style="background:var(--bg);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;">
<%- include('../partials/flash') %>

<div style="max-width:420px;width:100%;">
    <div style="text-align:center;margin-bottom:20px;">
        <a href="/" class="nav-logo" style="font-family:'Playfair Display',serif;font-size:22px;color:var(--primary);font-weight:700;text-decoration:none;">🍽 DineEase</a>
    </div>

    <div class="card" style="border-radius:16px;overflow:hidden;border-color:#60BB46;">
        <!-- eSewa header bar -->
        <div style="background:#60BB46;padding:18px 24px;display:flex;align-items:center;gap:12px;">
            <div style="width:40px;height:40px;background:rgba(255,255,255,0.2);border-radius:10px;display:flex;align-items:center;justify-content:center;color:white;font-weight:900;font-size:20px;">e</div>
            <div>
                <div style="color:white;font-weight:700;font-size:16px;">Pay with eSewa</div>
                <div style="color:rgba(255,255,255,0.8);font-size:12px;">Secure Nepal Digital Payment</div>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- Order summary -->
            <div style="background:var(--bg);padding:16px;border-radius:10px;margin-bottom:20px;">
                <div class="d-flex justify-content-between mb-2" style="font-size:13px;">
                    <span style="color:var(--text-muted);">Order</span>
                    <strong><%= order.orderNumber %></strong>
                </div>
                <div class="d-flex justify-content-between mb-2" style="font-size:13px;">
                    <span style="color:var(--text-muted);">Table</span>
                    <span>Table <%= order.table?.tableNumber %></span>
                </div>
                <% if (order.discountAmount > 0) { %>
                <div class="d-flex justify-content-between mb-2" style="font-size:13px;color:#27AE60;">
                    <span>Discount Applied</span>
                    <span>− Rs. <%= order.discountAmount.toFixed(2) %></span>
                </div>
                <% } %>
                <div style="border-top:1px solid var(--border);padding-top:12px;margin-top:8px;display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-weight:700;font-size:15px;">Total</span>
                    <span style="font-weight:700;font-size:22px;color:#60BB46;">Rs. <%= order.totalAmount.toFixed(2) %></span>
                </div>
            </div>

            <!-- Pay button -->
            <form action="<%= paymentData.gatewayUrl %>" method="POST">
                <% Object.entries(paymentData).forEach(([key, val]) => { %>
                <% if (key !== 'gatewayUrl' && key !== 'orderNumber') { %>
                <input type="hidden" name="<%= key %>" value="<%= val %>">
                <% } %>
                <% }) %>
                <button type="submit"
                    style="width:100%;background:#60BB46;color:white;border:none;padding:14px;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;">
                    <span style="font-size:22px;font-weight:900;line-height:1;">e</span>
                    Pay Rs. <%= order.totalAmount.toFixed(2) %>
                </button>
            </form>

            <a href="/my-orders" style="display:block;text-align:center;margin-top:14px;font-size:13px;color:var(--text-muted);text-decoration:none;">
                ← Back to my orders
            </a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
