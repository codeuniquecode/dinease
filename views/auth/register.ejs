<%- include('../partials/head', { title: 'Register' }) %>
<body class="auth-body">
<%- include('../partials/flash') %>

<div class="container" style="max-width:460px;">
    <div style="text-align:center;margin-bottom:32px;">
        <a href="/" style="font-family:'Playfair Display',serif;font-size:36px;color:var(--primary);font-weight:700;text-decoration:none;">🍽 DineEase</a>
        <div style="color:#888;font-size:13px;letter-spacing:1px;text-transform:uppercase;margin-top:6px;">Create Customer Account</div>
    </div>

    <div class="card" style="border-radius:16px;border:1px solid #333;background:#242424;">
        <div class="card-header" style="border-color:#333;background:transparent;">
            <span style="color:#EEE;font-size:16px;font-weight:600;">Customer Registration</span>
        </div>
        <div class="card-body p-4">
            <form action="/register" method="POST">
                <div class="mb-3">
                    <label class="form-label" style="color:#AAA;">Full Name</label>
                    <input type="text" name="name" class="form-control" required
                        style="background:#1A1A1A;border-color:#444;color:#EEE;"
                        placeholder="Your full name">
                </div>
                <div class="mb-3">
                    <label class="form-label" style="color:#AAA;">Phone Number</label>
                    <div style="position:relative;">
                        <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#888;font-size:13px;">+977</span>
                        <input type="tel" name="phone" class="form-control" required
                            style="background:#1A1A1A;border-color:#444;color:#EEE;padding-left:52px;"
                            placeholder="98XXXXXXXX"
                            pattern="[0-9]{10}"
                            title="Enter a valid 10-digit Nepali phone number">
                    </div>
                    <div style="font-size:11px;color:#666;margin-top:4px;">Enter 10-digit number e.g. 9812345678</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" style="color:#AAA;">Email Address</label>
                    <input type="email" name="email" class="form-control" required
                        style="background:#1A1A1A;border-color:#444;color:#EEE;"
                        placeholder="you@example.com">
                </div>
                <div class="mb-4">
                    <label class="form-label" style="color:#AAA;">Password</label>
                    <input type="password" name="password" class="form-control" required minlength="6"
                        style="background:#1A1A1A;border-color:#444;color:#EEE;"
                        placeholder="Minimum 6 characters">
                </div>
                <button type="submit" class="btn-primary-custom w-100" style="padding:12px;">
                    <i class="bi bi-person-plus-fill me-2"></i>Create Account
                </button>
            </form>
            <div style="text-align:center;margin-top:20px;color:#666;font-size:13px;">
                Already have an account?
                <a href="/login" style="color:var(--primary);text-decoration:none;font-weight:600;">Sign in</a>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
