<%- include('../partials/head', { title: 'Login' }) %>
<body class="auth-body">
<%- include('../partials/flash') %>

<div class="container" style="max-width:420px;">
    <div style="text-align:center;margin-bottom:32px;">
        <a href="/" style="font-family:'Playfair Display',serif;font-size:36px;color:var(--primary);font-weight:700;text-decoration:none;">🍽 DineEase</a>
        <div style="color:#888;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;margin-top:6px;">Restaurant Management System</div>
    </div>

    <div class="card" style="border-radius:16px;border:1px solid #333;background:#242424;">
        <div class="card-header" style="border-color:#333;background:transparent;">
            <span style="color:#EEE;font-size:16px;font-weight:600;">Sign In</span>
        </div>
        <div class="card-body p-4">
            <form action="/login" method="POST">
                <div class="mb-3">
                    <label class="form-label" style="color:#AAA;">Email Address</label>
                    <input type="email" name="email" class="form-control" required autofocus
                        style="background:#1A1A1A;border-color:#444;color:#EEE;"
                        placeholder="Enter your email">
                </div>
                <div class="mb-4">
                    <label class="form-label" style="color:#AAA;">Password</label>
                    <div class="password-wrapper">
                        <input type="password" name="password" id="loginPassword" class="form-control" required
                            style="background:#1A1A1A;border-color:#444;color:#EEE;padding-right:40px;"
                            placeholder="Enter your password">
                        <button type="button" class="toggle-eye" onclick="togglePwd('loginPassword', this)">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn-primary-custom w-100" style="padding:12px;">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </form>
            <div style="text-align:center;margin-top:20px;color:#666;font-size:13px;">
                New customer?
                <a href="/register" style="color:var(--primary);text-decoration:none;font-weight:600;">Create account</a>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function togglePwd(inputId, btn) {
    const input = document.getElementById(inputId);
    const icon  = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye-slash';
    }
}
</script>
</body></html>
