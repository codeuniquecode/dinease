<%- include('../partials/head', { title: 'All Orders' , pageStyle: 'admin'}) %>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/adminSidebar', { activePage: 'orders' }) %>
<div class="main-content">
    <div class="page-header">
        <h1 class="page-title">All Orders</h1>
        <span style="font-size:13px;color:var(--text-muted);"><%= orders.length %> orders</span>
    </div>
    <div class="page-body">
        <!-- Filter buttons -->
        <div class="mb-3 d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-outline-secondary active" onclick="filterStatus('all',this)">All</button>
            <% ['placed','confirmed','preparing','ready','served','billed','completed','cancelled'].forEach(s => { %>
            <button class="btn btn-sm btn-outline-secondary" onclick="filterStatus('<%= s %>',this)">
                <%= s.charAt(0).toUpperCase() + s.slice(1) %>
            </button>
            <% }) %>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table mb-0" id="ordersTable">
                    <thead><tr>
                        <th>Order #</th><th>Table</th><th>Items</th><th>Amount</th><th>Status</th><th>Waiter</th><th>Time</th><th>Actions</th>
                    </tr></thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                        <tr data-status="<%= order.status %>">
                            <td>
                                <div style="font-weight:700;"><%= order.orderNumber %></div>
                                <div style="font-size:11px;color:var(--text-muted);"><%= order.isQROrder ? '📱 QR Order' : '👨‍💼 Staff' %></div>
                            </td>
                            <td>Table <%= order.table?.tableNumber %><br><span style="font-size:11px;color:var(--text-muted);"><%= order.table?.location %></span></td>
                            <td>
                                <span style="font-size:13px;"><%= order.items.length %> item(s)</span>
                                <div style="font-size:11px;color:var(--text-muted);">
                                    <%= order.items.slice(0,2).map(i => i.name).join(', ') %><%= order.items.length > 2 ? '...' : '' %>
                                </div>
                            </td>
                            <td>
                                <div style="font-weight:700;">Rs. <%= order.totalAmount > 0 ? order.totalAmount.toFixed(0) : order.subtotal.toFixed(0) %></div>
                                <% if (order.isPaid) { %><span style="font-size:11px;color:#27AE60;font-weight:600;">✓ PAID</span><% } %>
                            </td>
                            <td><span class="status-badge status-<%= order.status %>"><%= order.status %></span></td>
                            <td style="font-size:13px;"><%= order.waiter?.name || '—' %></td>
                            <td style="font-size:12px;color:var(--text-muted);">
                                <%= new Date(order.placedAt).toLocaleString('en-NP', {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) %>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <% if (order.status === 'served' && !order.isPaid) { %>
                                    <a href="/order/<%= order._id %>/bill" class="btn btn-sm btn-warning">Bill</a>
                                    <% } %>
                                    <% if (!order.isPaid && order.status !== 'cancelled' && order.status !== 'completed') { %>
                                    <form action="/order/<%= order._id %>/cancel" method="POST" onsubmit="return confirm('Cancel order?')">
                                        <button class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function filterStatus(status, btn) {
    document.querySelectorAll('#ordersTable tbody tr').forEach(row => {
        row.style.display = (status === 'all' || row.dataset.status === status) ? '' : 'none';
    });
    document.querySelectorAll('.btn-outline-secondary').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
}
</script>
</body></html>
