<%- include('../partials/head', { title: 'Inventory' , pageStyle: 'admin'}) %>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/adminSidebar', { activePage: 'inventory' }) %>
<div class="main-content">
    <div class="page-header">
        <h1 class="page-title">Inventory Management</h1>
        <button class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addStockModal">
            <i class="bi bi-plus-circle-fill me-2"></i>Add / Restock
        </button>
    </div>
    <div class="page-body">

        <!-- Low stock alert -->
        <% const lowItems = inventory.filter(i => i.isLow); %>
        <% if (lowItems.length > 0) { %>
        <div style="background:#FDEDEC;border:1.5px solid #C0392B;border-radius:10px;padding:14px 18px;margin-bottom:20px;">
            <div class="d-flex align-items-center gap-2" style="color:#C0392B;font-weight:600;margin-bottom:6px;">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <%= lowItems.length %> item(s) below minimum threshold
            </div>
            <div style="font-size:13px;color:#922B21;">
                <% lowItems.forEach(i => { %><strong><%= i.name %></strong> (<%= i.currentStock %> <%= i.unit %> left)&nbsp; <% }) %>
            </div>
        </div>
        <% } %>

        <div class="card">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Ingredient</th><th>Unit</th><th>Current Stock</th><th>Min Threshold</th><th>Status</th><th>Last Restocked</th><th>Actions</th></tr></thead>
                    <tbody>
                        <% inventory.forEach(item => { %>
                        <tr style="<%= item.isLow ? 'background:#FFF8F8;' : '' %>">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <% if (item.isLow) { %><i class="bi bi-exclamation-circle-fill text-danger" style="font-size:14px;"></i><% } %>
                                    <strong><%= item.name %></strong>
                                </div>
                            </td>
                            <td style="color:var(--text-muted);"><%= item.unit %></td>
                            <td>
                                <span style="font-weight:700;color:<%= item.isLow ? '#C0392B' : '#27AE60' %>;">
                                    <%= item.currentStock %>
                                </span>
                                <span style="font-size:11px;color:var(--text-muted);"> <%= item.unit %></span>
                            </td>
                            <td style="font-size:13px;color:var(--text-muted);"><%= item.minimumThreshold %> <%= item.unit %></td>
                            <td>
                                <span class="status-badge <%= item.isLow ? 'status-cancelled' : 'status-available' %>">
                                    <%= item.isLow ? '⚠ Low Stock' : 'OK' %>
                                </span>
                            </td>
                            <td style="font-size:12px;color:var(--text-muted);">
                                <%= new Date(item.lastRestocked).toLocaleDateString('en-NP') %>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" onclick='openEdit(<%- JSON.stringify({id:item._id,name:item.name,stock:item.currentStock,threshold:item.minimumThreshold}) %>)'>
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add/Restock Modal -->
<div class="modal fade" id="addStockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Add / Restock Ingredient</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <form action="/admin/inventory" method="POST">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Ingredient Name</label>
                            <input type="text" name="name" class="form-control" required placeholder="e.g. Chicken">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Unit</label>
                            <select name="unit" class="form-select">
                                <option value="kg">kg</option>
                                <option value="liters">liters</option>
                                <option value="pieces">pieces</option>
                                <option value="packets">packets</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Stock Amount</label>
                            <input type="number" name="currentStock" class="form-control" required min="0" step="0.1">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Minimum Threshold</label>
                            <input type="number" name="minimumThreshold" class="form-control" required min="0" step="0.1" value="10">
                        </div>
                    </div>
                    <div style="font-size:12px;color:var(--text-muted);margin-top:10px;">
                        <i class="bi bi-info-circle me-1"></i>If ingredient already exists, stock will be added to current level.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editStockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Update <span id="editItemName"></span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <form id="editStockForm" method="POST">
                <input type="hidden" name="_method" value="PUT">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Current Stock</label>
                            <input type="number" name="currentStock" id="editStock" class="form-control" required min="0" step="0.1">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Minimum Threshold</label>
                            <input type="number" name="minimumThreshold" id="editThreshold" class="form-control" required min="0" step="0.1">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function openEdit(item) {
    document.getElementById("editStockForm").action = "/admin/inventory/" + item.id + "?_method=PUT";
    document.getElementById('editItemName').textContent = item.name;
    document.getElementById('editStock').value = item.stock;
    document.getElementById('editThreshold').value = item.threshold;
    new bootstrap.Modal(document.getElementById('editStockModal')).show();
}
</script>
</body></html>
