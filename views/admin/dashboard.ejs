<%- include('../partials/head', { title: 'Admin Dashboard' , pageStyle: 'admin'}) %>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/adminSidebar', { activePage: 'dashboard' }) %>

<div class="main-content">
    <div class="page-header">
        <h1 class="page-title">Dashboard</h1>
        <div style="font-size:13px;color:var(--text-muted);">
            <i class="bi bi-clock me-1"></i>
            <span id="liveTime"></span>
        </div>
    </div>
    <div class="page-body">

        <!-- Stat Cards -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-sm-6">
                <div class="stat-card bg-primary-custom">
                    <div class="stat-label">Total Revenue</div>
                    <div class="stat-value">Rs. <%= Math.round(stats.totalRevenue).toLocaleString() %></div>
                    <i class="bi bi-currency-rupee stat-icon"></i>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="stat-card bg-success-custom">
                    <div class="stat-label">Total Orders</div>
                    <div class="stat-value"><%= stats.totalOrders %></div>
                    <i class="bi bi-receipt stat-icon"></i>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="stat-card bg-info-custom">
                    <div class="stat-label">Active Customers</div>
                    <div class="stat-value"><%= stats.totalUsers %></div>
                    <i class="bi bi-people stat-icon"></i>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="stat-card <%= stats.lowInventory > 0 ? 'bg-danger-custom' : 'bg-warning-custom' %>">
                    <div class="stat-label">Low Inventory Alerts</div>
                    <div class="stat-value"><%= stats.lowInventory %></div>
                    <i class="bi bi-exclamation-triangle stat-icon"></i>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Algorithm 1: SMA Revenue Forecast Chart -->
            <div class="col-xl-8">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Revenue Forecast (Last 14 Days + 3-Day Projection)</span>
                        <span class="badge" style="background:var(--primary-light);color:var(--primary);font-size:10px;">SMA n=7</span>
                    </div>
                    <div class="card-body" style="padding:20px;">
                        <canvas id="revenueChart" height="100"></canvas>
                    </div>
                </div>
            </div>

            <!-- Best Sellers -->
            <div class="col-xl-4">
                <div class="card h-100">
                    <div class="card-header">Top Selling Items</div>
                    <div class="card-body p-0">
                        <% bestSellers.forEach((item, i) => { %>
                        <div class="d-flex align-items-center justify-content-between" style="padding:12px 18px;border-bottom:1px solid var(--border);">
                            <div class="d-flex align-items-center gap-2">
                                <span style="width:22px;height:22px;background:var(--primary-light);color:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;"><%= i+1 %></span>
                                <div>
                                    <div style="font-size:13px;font-weight:600;"><%= item.name %></div>
                                    <div style="font-size:11px;color:var(--text-muted);"><%= item.category %></div>
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <div style="font-size:13px;font-weight:600;color:var(--primary);">Rs. <%= item.price %></div>
                                <div style="font-size:11px;color:var(--text-muted);"><%= item.orderCount %> orders</div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Algorithm 5: Peak Hour Detection Chart -->
            <div class="col-xl-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Peak Hour Detection</span>
                        <span id="peakBadge" class="badge" style="background:#FDEDEC;color:var(--danger);font-size:10px;"></span>
                    </div>
                    <div class="card-body" style="padding:20px;">
                        <canvas id="peakHourChart" height="90"></canvas>
                        <div id="peakStats" style="margin-top:12px;font-size:12px;color:var(--text-muted);"></div>
                    </div>
                </div>
            </div>

            <!-- Category Revenue -->
            <div class="col-xl-4">
                <div class="card">
                    <div class="card-header">Revenue by Category</div>
                    <div class="card-body" style="padding:20px;">
                        <canvas id="categoryChart" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick links -->
        <div class="row g-3">
            <div class="col-md-3">
                <a href="/admin/orders" class="card text-decoration-none" style="padding:18px;display:block;text-align:center;">
                    <i class="bi bi-receipt-cutoff" style="font-size:28px;color:var(--primary);"></i>
                    <div style="font-size:13px;font-weight:600;margin-top:8px;">Manage Orders</div>
                    <div style="font-size:11px;color:var(--text-muted);">
                        <span style="color:var(--warning);font-weight:600;"><%= stats.pendingOrders %></span> pending
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="/admin/inventory" class="card text-decoration-none" style="padding:18px;display:block;text-align:center;">
                    <i class="bi bi-box-seam-fill" style="font-size:28px;color:var(--info);"></i>
                    <div style="font-size:13px;font-weight:600;margin-top:8px;">Inventory</div>
                    <div style="font-size:11px;color:var(--text-muted);">
                        <% if (stats.lowInventory > 0) { %>
                        <span style="color:var(--danger);font-weight:600;"><%= stats.lowInventory %> low stock</span>
                        <% } else { %> All stocked <% } %>
                    </div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="/admin/menu" class="card text-decoration-none" style="padding:18px;display:block;text-align:center;">
                    <i class="bi bi-journal-text" style="font-size:28px;color:var(--success);"></i>
                    <div style="font-size:13px;font-weight:600;margin-top:8px;">Menu Items</div>
                    <div style="font-size:11px;color:var(--text-muted);">Add / edit menu</div>
                </a>
            </div>
            <div class="col-md-3">
                <a href="/admin/analytics" class="card text-decoration-none" style="padding:18px;display:block;text-align:center;">
                    <i class="bi bi-bar-chart-line-fill" style="font-size:28px;color:var(--warning);"></i>
                    <div style="font-size:13px;font-weight:600;margin-top:8px;">Full Analytics</div>
                    <div style="font-size:11px;color:var(--text-muted);">All algorithms</div>
                </a>
            </div>
        </div>

    </div><!-- page-body -->
</div><!-- main-content -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    // Live clock
    function updateTime() {
        const now = new Date();
        document.getElementById('liveTime').textContent = now.toLocaleTimeString('en-NP', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
    setInterval(updateTime, 1000); updateTime();

    // --- Algorithm 1: SMA Revenue Forecast Chart ---
    const forecastRaw = <%- forecastSeries %>;
    const labels = forecastRaw.map((d, i) => {
        const daysAgo = forecastRaw.length - 1 - i;
        if (d.type === 'predicted') return `+${i - forecastRaw.filter(x => x.type === 'actual').length + 1}d (pred)`;
        const date = new Date(); date.setDate(date.getDate() - daysAgo);
        return date.toLocaleDateString('en-NP', { month: 'short', day: 'numeric' });
    });
    const actualData = forecastRaw.map(d => d.type === 'actual' ? d.value : null);
    const predData = forecastRaw.map(d => d.type === 'predicted' ? d.value : null);

    new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: {
            labels,
            datasets: [
                {
                    label: 'Actual Revenue (Rs.)',
                    data: actualData,
                    borderColor: '#C8873A', backgroundColor: 'rgba(200,135,58,0.1)',
                    borderWidth: 2.5, pointRadius: 4, tension: 0.4, fill: true
                },
                {
                    label: 'SMA Forecast (Rs.)',
                    data: predData,
                    borderColor: '#2980B9', backgroundColor: 'rgba(41,128,185,0.08)',
                    borderWidth: 2, borderDash: [6, 4], pointRadius: 5,
                    pointStyle: 'triangle', tension: 0.4, fill: true
                }
            ]
        },
        options: {
            responsive: true, plugins: { legend: { position: 'top', labels: { font: { size: 12 } } } },
            scales: { y: { beginAtZero: false, ticks: { callback: v => 'Rs.' + v.toLocaleString() } } }
        }
    });

    // --- Algorithm 5: Peak Hour Chart ---
    const peakRaw = <%- peakData %>;
    const hourLabels = peakRaw.hourAnalysis.map(h => h.label);
    const hourCounts = peakRaw.hourAnalysis.map(h => h.orderCount);
    const barColors = peakRaw.hourAnalysis.map(h => h.isPeak ? '#C0392B' : 'rgba(200,135,58,0.7)');

    new Chart(document.getElementById('peakHourChart'), {
        type: 'bar',
        data: {
            labels: hourLabels,
            datasets: [{
                label: 'Orders per Hour',
                data: hourCounts,
                backgroundColor: barColors,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: ctx => `${ctx.raw} orders${peakRaw.hourAnalysis[ctx.dataIndex].isPeak ? ' 🔥 PEAK' : ''}` } }
            },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    const peakList = peakRaw.peakHours.map(h => `${String(h).padStart(2,'0')}:00`).join(', ');
    document.getElementById('peakBadge').textContent = peakRaw.peakHours.length + ' peak hours';
    document.getElementById('peakStats').innerHTML =
        `<b>μ (mean):</b> ${peakRaw.mean} orders/hr &nbsp;|&nbsp; <b>σ (std dev):</b> ${peakRaw.stdDev} &nbsp;|&nbsp; <b>Threshold (μ+σ):</b> ${peakRaw.threshold} &nbsp;|&nbsp; <b>Peak hours:</b> ${peakList || 'None detected yet'}`;

    // --- Category Revenue Donut ---
    const catRaw = <%- categoryRevenue %>;
    new Chart(document.getElementById('categoryChart'), {
        type: 'doughnut',
        data: {
            labels: catRaw.map(c => c._id),
            datasets: [{ data: catRaw.map(c => c.revenue), backgroundColor: ['#C8873A','#2980B9','#27AE60','#8E44AD','#E67E22','#C0392B'], borderWidth: 2 }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } } }
    });
</script>
</body></html>
