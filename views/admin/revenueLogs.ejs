<%- include('../partials/head', { title: 'Revenue Logs', pageStyle: 'admin' }) %>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/adminSidebar', { activePage: 'revenue' }) %>

<div class="main-content">
    <div class="page-header">
        <h1 class="page-title">Revenue Logs</h1>
        <div style="font-size:13px;color:var(--text-muted);">
            <i class="bi bi-calendar3 me-1"></i> Last 30 days
        </div>
    </div>

    <div class="page-body">

        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-sm-6">
                <div class="stat-card bg-primary-custom">
                    <div class="stat-label">Total Revenue (30 Days)</div>
                    <div class="stat-value">
                        Rs. <%= Math.round(logs.reduce((s, l) => s + (l.totalRevenue || 0), 0)).toLocaleString() %>
                    </div>
                    <i class="bi bi-currency-rupee stat-icon"></i>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="stat-card bg-success-custom">
                    <div class="stat-label">Total Orders (30 Days)</div>
                    <div class="stat-value">
                        <%= logs.reduce((s, l) => s + (l.totalOrders || 0), 0) %>
                    </div>
                    <i class="bi bi-bag-check stat-icon"></i>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="stat-card bg-info-custom">
                    <div class="stat-label">Average Daily Revenue</div>
                    <div class="stat-value">
                        Rs. <%= logs.length > 0 ? Math.round(logs.reduce((s, l) => s + (l.totalRevenue || 0), 0) / logs.length).toLocaleString() : 0 %>
                    </div>
                    <i class="bi bi-graph-up stat-icon"></i>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="stat-card bg-warning-custom">
                    <div class="stat-label">Best Day Revenue</div>
                    <div class="stat-value">
                        Rs. <%= logs.length > 0 ? Math.round(Math.max(...logs.map(l => l.totalRevenue || 0))).toLocaleString() : 0 %>
                    </div>
                    <i class="bi bi-star-fill stat-icon"></i>
                </div>
            </div>
        </div>

        <!-- Revenue Logs Table -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Daily Revenue Breakdown</span>
                <span style="font-size:12px;color:var(--text-muted);">
                    Showing <%= logs.length %> record<%= logs.length !== 1 ? 's' : '' %>
                </span>
            </div>

            <% if (logs.length === 0) { %>
            <div style="padding:48px;text-align:center;color:var(--text-muted);">
                <i class="bi bi-inbox" style="font-size:40px;display:block;margin-bottom:12px;color:var(--border);"></i>
                No revenue records yet. Revenue is logged automatically when orders are paid.
            </div>
            <% } else { %>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Total Orders</th>
                            <th>Total Revenue</th>
                            <th>Avg. per Order</th>
                            <th>Peak Hour</th>
                            <th>Hourly Activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% logs.forEach(log => {
                            // Find peak hour from hourlyBreakdown map
                            let peakHour = '—';
                            let peakCount = 0;
                            if (log.hourlyBreakdown && log.hourlyBreakdown.size > 0) {
                                log.hourlyBreakdown.forEach((count, hour) => {
                                    if (count > peakCount) {
                                        peakCount = count;
                                        peakHour = hour + ':00';
                                    }
                                });
                            }
                            const avgPerOrder = log.totalOrders > 0
                                ? Math.round(log.totalRevenue / log.totalOrders)
                                : 0;
                        %>
                        <tr>
                            <td>
                                <strong><%= log.date %></strong>
                            </td>
                            <td>
                                <span class="status-badge status-confirmed">
                                    <%= log.totalOrders %> orders
                                </span>
                            </td>
                            <td>
                                <strong style="color:var(--primary);">
                                    Rs. <%= Math.round(log.totalRevenue).toLocaleString() %>
                                </strong>
                            </td>
                            <td style="color:var(--text-muted);">
                                Rs. <%= avgPerOrder.toLocaleString() %>
                            </td>
                            <td>
                                <% if (peakHour !== '—') { %>
                                <span style="background:#FEF9E7;color:#D4890A;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;">
                                    <i class="bi bi-clock me-1"></i><%= peakHour %>
                                </span>
                                <% } else { %>
                                <span style="color:var(--text-muted);font-size:12px;">—</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (log.hourlyBreakdown && log.hourlyBreakdown.size > 0) { %>
                                <div style="display:flex;gap:4px;flex-wrap:wrap;">
                                    <% log.hourlyBreakdown.forEach((count, hour) => { %>
                                    <span style="background:var(--bg);border:1px solid var(--border);padding:2px 7px;border-radius:6px;font-size:10px;font-family:'JetBrains Mono',monospace;">
                                        <%= hour %>h: <%= count %>
                                    </span>
                                    <% }); %>
                                </div>
                                <% } else { %>
                                <span style="color:var(--text-muted);font-size:12px;">No hourly data</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
