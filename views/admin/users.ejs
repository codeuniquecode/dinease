<%- include('../partials/head', { title: 'Users' , pageStyle: 'admin'}) %>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/adminSidebar', { activePage: 'users' }) %>
<div class="main-content">
    <div class="page-header">
        <h1 class="page-title">User Management</h1>
        <span style="font-size:13px;color:var(--text-muted);"><%= users.length %> total users</span>
    </div>
    <div class="page-body">
        <div class="card">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Orders</th><th>Status</th><th>Joined</th><th>Actions</th></tr></thead>
                    <tbody>
                        <% users.forEach(u => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:32px;height:32px;border-radius:50%;background:var(--primary);display:flex;align-items:center;justify-content:center;color:white;font-size:12px;font-weight:700;flex-shrink:0;">
                                        <%= u.name.charAt(0).toUpperCase() %>
                                    </div>
                                    <strong><%= u.name %></strong>
                                </div>
                            </td>
                            <td style="font-size:13px;"><%= u.email %></td>
                            <td>
                                <form action="/admin/users/<%= u._id %>/role?_method=PATCH" method="POST">
                                    <select name="role" class="form-select form-select-sm" style="width:110px;" onchange="this.form.submit()">
                                        <% ['admin','waiter','kitchen','customer'].forEach(r => { %>
                                        <option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= r.charAt(0).toUpperCase() + r.slice(1) %></option>
                                        <% }) %>
                                    </select>
                                </form>
                            </td>
                            <td style="font-weight:600;color:var(--primary);"><%= u.totalOrders %></td>
                            <td>
                                <span class="status-badge <%= u.isActive ? 'status-available' : 'status-cancelled' %>">
                                    <%= u.isActive ? 'Active' : 'Inactive' %>
                                </span>
                            </td>
                            <td style="font-size:12px;color:var(--text-muted);">
                                <%= new Date(u.createdAt).toLocaleDateString('en-NP') %>
                            </td>
                            <td>
                                <form action="/admin/users/<%= u._id %>/toggle?_method=PATCH" method="POST" onsubmit="return confirm('Toggle user status?')">
                                    <button class="btn btn-sm <%= u.isActive ? 'btn-outline-danger' : 'btn-outline-success' %>">
                                        <i class="bi bi-<%= u.isActive ? 'person-slash' : 'person-check' %>"></i>
                                        <%= u.isActive ? 'Deactivate' : 'Activate' %>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
