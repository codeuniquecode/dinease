<%- include('../partials/head', { title: 'Reservations' , pageStyle: 'admin'}) %>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/adminSidebar', { activePage: 'reservations' }) %>

<div class="main-content">
    <div class="page-header">
        <h1 class="page-title">Reservations</h1>
        <span style="font-size:13px;color:var(--text-muted);"><%= reservations.length %> total</span>
    </div>
    <div class="page-body">

        <!-- Today's reservations -->
        <% const today = new Date().toDateString();
           const todayRes = reservations.filter(r =>
               new Date(r.reservationDate).toDateString() === today && r.status !== 'cancelled'
           ); %>
        <% if (todayRes.length > 0) { %>
        <div style="background:#EBF5FB;border:1.5px solid #2980B9;border-radius:10px;padding:14px 18px;margin-bottom:20px;">
            <div style="font-weight:600;color:#1A6B8A;margin-bottom:6px;">
                <i class="bi bi-calendar-event-fill me-2"></i><%= todayRes.length %> reservation(s) today
            </div>
            <div style="font-size:13px;color:#555;">
                <% todayRes.forEach(r => { %>
                <span style="margin-right:16px;">
                    👥 <%= r.partySize %>p · Table <%= r.table?.tableNumber %> ·
                    <%= r.timeSlot %>
                    <span class="status-badge status-<%= r.status %>"><%= r.status %></span>
                </span>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- Filters -->
        <div class="mb-3 d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-outline-secondary active" onclick="filterStatus('all',this)">All</button>
            <% ['pending','confirmed','cancelled','completed'].forEach(s => { %>
            <button class="btn btn-sm btn-outline-secondary" onclick="filterStatus('<%= s %>',this)">
                <%= s.charAt(0).toUpperCase() + s.slice(1) %>
            </button>
            <% }) %>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table mb-0" id="resTable">
                    <thead><tr>
                        <th>Customer</th>
                        <th>Table</th>
                        <th>Party</th>
                        <th>Date</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th>Requests</th>
                        <th>Actions</th>
                    </tr></thead>
                    <tbody>
                        <% if (reservations.length === 0) { %>
                        <tr>
                            <td colspan="8" style="text-align:center;padding:32px;color:var(--text-muted);">No reservations yet</td>
                        </tr>
                        <% } %>
                        <% reservations.forEach(res => { %>
                        <tr data-status="<%= res.status %>"
                            style="<%= new Date(res.reservationDate).toDateString() === today && res.status !== 'cancelled' ? 'background:#FAFFF8;' : '' %>">
                            <td>
                                <div style="font-weight:600;"><%= res.customer?.name || '—' %></div>
                                <div style="font-size:11px;color:var(--text-muted);">
                                    📞 <%= res.customer?.phone || '—' %>
                                </div>
                            </td>
                            <td>
                                Table <%= res.table?.tableNumber %>
                                <div style="font-size:11px;color:var(--text-muted);">
                                    <%= res.table?.capacity %>p · <%= res.table?.location %>
                                </div>
                            </td>
                            <td style="font-weight:600;"><%= res.partySize %> guests</td>
                            <td style="font-size:13px;">
                                <%= new Date(res.reservationDate).toLocaleDateString('en-NP',{weekday:'short',month:'short',day:'numeric'}) %>
                            </td>
                            <td style="font-size:13px;"><%= res.timeSlot %></td>
                            <td>
                                <span class="status-badge status-<%= res.status %>"><%= res.status %></span>
                            </td>
                            <td style="font-size:12px;color:var(--text-muted);max-width:140px;">
                                <%= res.specialRequests || '—' %>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <% if (res.status === 'pending') { %>
                                    <form action="/admin/reservation/<%= res._id %>/confirm?_method=PATCH" method="POST">
                                        <button class="btn btn-sm btn-success">
                                            <i class="bi bi-check-lg"></i> Confirm
                                        </button>
                                    </form>
                                    <form action="/admin/reservation/<%= res._id %>/cancel?_method=PATCH" method="POST"
                                        onsubmit="return confirm('Cancel this reservation?')">
                                        <button class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                    <% } else if (res.status === 'confirmed') { %>
                                    <form action="/admin/reservation/<%= res._id %>/cancel?_method=PATCH" method="POST"
                                        onsubmit="return confirm('Cancel confirmed reservation?')">
                                        <button class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                    <% } else { %>
                                    <span style="font-size:11px;color:var(--text-muted);">—</span>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function filterStatus(status, btn) {
    document.querySelectorAll('#resTable tbody tr[data-status]').forEach(row => {
        row.style.display = (status === 'all' || row.dataset.status === status) ? '' : 'none';
    });
    document.querySelectorAll('.btn-outline-secondary').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
}
</script>
</body></html>
