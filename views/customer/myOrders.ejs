<%- include('../partials/head', { title: 'My Orders', pageStyle: 'customer' }) %>
<body>
<%- include('../partials/flash') %>

<nav class="customer-nav">
    <a href="/" class="nav-logo">🍽 DineEase</a>
    <div class="nav-links">
        <a href="/menu">Menu</a>
        <a href="/order/new">Order Food</a>
        <a href="/reserve">Reserve</a>
        <a href="/my-orders" class="active">My Orders</a>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <span style="color:#555;font-size:11px;">|</span>
        <span style="color:#888;font-size:13px;"><%= currentUser.name.split(' ')[0] %></span>
        <a href="/logout" style="color:var(--primary) !important;">Logout</a>
        <% } %>
    </div>
</nav>

<div style="max-width:960px;margin:0 auto;padding:40px 24px;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 style="font-family:'Playfair Display',serif;font-size:28px;margin:0;">My Orders</h1>
            <p style="color:var(--text-muted);font-size:13px;margin:4px 0 0;">Track and pay for your orders</p>
        </div>
        <a href="/order/new" class="btn-primary-custom" style="text-decoration:none;">
            <i class="bi bi-plus-circle-fill me-2"></i>New Order
        </a>
    </div>

    <% if (orders.length === 0) { %>
    <div style="text-align:center;padding:60px;color:var(--text-muted);">
        <i class="bi bi-bag-x" style="font-size:48px;display:block;margin-bottom:12px;color:var(--border);"></i>
        <div style="font-size:16px;margin-bottom:12px;">No orders yet</div>
        <a href="/order/new" class="btn-primary-custom" style="text-decoration:none;">Order Food Now</a>
    </div>
    <% } else { %>
    <div class="d-flex flex-column gap-3">
        <% orders.forEach(order => { %>
        <div class="card" style="border-radius:14px;overflow:hidden;">
            <!-- Order header -->
            <div style="padding:16px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;border-bottom:1px solid var(--border);">
                <div class="d-flex align-items-center gap-3">
                    <div>
                        <div style="font-weight:700;font-size:15px;"><%= order.orderNumber %></div>
                        <div style="font-size:12px;color:var(--text-muted);">
                            Table <%= order.table?.tableNumber %>
                            &nbsp;·&nbsp;
                            <%= new Date(order.placedAt).toLocaleString('en-NP',{dateStyle:'medium',timeStyle:'short'}) %>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="status-badge status-<%= order.status %>"><%= order.status %></span>
                    <span style="font-weight:700;font-size:16px;color:var(--primary);">
                        Rs. <%= order.totalAmount > 0 ? order.totalAmount.toFixed(2) : order.subtotal.toFixed(2) %>
                    </span>
                </div>
            </div>

            <!-- Items -->
            <div style="padding:12px 20px;border-bottom:1px solid var(--border);background:var(--bg);">
                <div class="d-flex flex-wrap gap-2">
                    <% order.items.forEach(item => { %>
                    <span style="background:white;border:1px solid var(--border);padding:4px 10px;border-radius:20px;font-size:12px;">
                        <%= item.name %> <strong style="color:var(--primary);">×<%= item.quantity %></strong>
                    </span>
                    <% }) %>
                </div>
            </div>

            <!-- Actions -->
            <div style="padding:12px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <div style="font-size:12px;color:var(--text-muted);">
                    <% if (order.isPaid) { %>
                    <span style="color:#27AE60;font-weight:600;">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        Paid via <%= order.paymentMethod?.toUpperCase() %>
                    </span>
                    <% } else if (order.status === 'billed') { %>
                    <span style="color:#E67E22;font-weight:600;">
                        <i class="bi bi-receipt me-1"></i>Bill ready — please pay
                    </span>
                    <% } else { %>
                    <span>Status: <strong><%= order.status %></strong></span>
                    <% } %>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <%# Show receipt if paid %>
                    <% if (order.isPaid) { %>
                    <a href="/order/receipt/<%= order._id %>"
                        style="background:var(--bg);border:1px solid var(--border);color:var(--text);padding:6px 14px;border-radius:8px;font-size:13px;text-decoration:none;font-weight:500;">
                        <i class="bi bi-receipt me-1"></i>Receipt
                    </a>
                    <a href="/order/invoice/<%= order._id %>" target="_blank"
                        style="background:var(--bg);border:1px solid var(--border);color:var(--text);padding:6px 14px;border-radius:8px;font-size:13px;text-decoration:none;font-weight:500;">
                        <i class="bi bi-file-pdf me-1"></i>PDF
                    </a>
                    <% } %>

                    <%# Show eSewa pay button if billed and not paid %>
                    <% if (order.status === 'billed' && !order.isPaid) { %>
                    <a href="/payment/esewa/customer/<%= order._id %>"
                        style="background:#60BB46;color:white;padding:6px 16px;border-radius:8px;font-size:13px;text-decoration:none;font-weight:700;display:inline-flex;align-items:center;gap:6px;">
                        <span style="font-weight:900;font-size:16px;line-height:1;">e</span>
                        Pay with eSewa — Rs. <%= order.totalAmount.toFixed(2) %>
                    </a>
                    <% } %>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
    <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
    // Live update — when order status changes, reload to show Pay button
    const socket = io();
    socket.on('orderStatusUpdate', (data) => {
        if (data.status === 'billed' || data.status === 'completed') {
            setTimeout(() => location.reload(), 800);
        }
    });
</script>
</body></html>
