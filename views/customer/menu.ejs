<%- include('../partials/head', { title: 'Menu', pageStyle: 'customer' }) %>
<body>
<%- include('../partials/flash') %>

<nav class="customer-nav">
    <a href="/" class="nav-logo">🍽 DineEase</a>
    <div class="nav-links d-flex gap-3 align-items-center">
        <a href="/menu">Menu</a>
        <a href="/order/new" style="color:var(--primary);font-weight:600;">Order Food</a>
        <a href="/reserve">Reserve Table</a>
        <a href="/my-orders">My Orders</a>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <span style="color:#888;font-size:13px;border-left:1px solid #444;padding-left:12px;"><%= currentUser.name %></span>
        <a href="/logout" style="color:var(--primary);font-size:13px;">Logout</a>
        <% } else { %>
        <a href="/login" class="btn-primary-custom" style="padding:7px 16px;font-size:13px;text-decoration:none;">Login</a>
        <% } %>
    </div>
</nav>

<div style="max-width:1100px;margin:0 auto;padding:40px 24px;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 style="font-family:'Playfair Display',serif;font-size:32px;margin:0;">Our Menu</h1>
            <p style="color:var(--text-muted);margin:4px 0 0;font-size:14px;">Fresh ingredients, authentic recipes</p>
        </div>
        <a href="/order/new" class="btn-primary-custom" style="text-decoration:none;">
            <i class="bi bi-cart-plus-fill me-2"></i>Order Now
        </a>
    </div>

    <!-- Category filter -->
    <div class="mb-4 d-flex gap-2 flex-wrap">
        <button class="btn btn-sm btn-outline-secondary active" onclick="filterCat('all',this)">All Items</button>
        <% Object.keys(menuByCategory).forEach(cat => { %>
        <button class="btn btn-sm btn-outline-secondary" onclick="filterCat('<%= cat %>',this)"><%= cat %></button>
        <% }) %>
    </div>

    <% Object.entries(menuByCategory).forEach(([cat, items]) => { %>
    <div class="cat-section mb-5" data-category="<%= cat %>">
        <h2 style="font-family:'Playfair Display',serif;font-size:22px;margin-bottom:16px;padding-bottom:8px;border-bottom:2px solid var(--border);">
            <%= cat %>
        </h2>
        <div class="menu-grid">
            <% items.forEach(item => { %>
            <div class="menu-card">
                <div class="menu-emoji">
                    <% const emojis = {Appetizer:'🥟','Main Course':'🍛',Dessert:'🍮',Beverage:'☕',Snacks:'🥨',Special:'⭐'}; %>
                    <%= emojis[item.category] || '🍽' %>
                </div>
                <div style="padding:16px;">
                    <div style="font-size:15px;font-weight:700;"><%= item.name %></div>
                    <div style="font-size:12px;color:var(--text-muted);margin:4px 0 10px;line-height:1.5;"><%= item.description %></div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span style="color:var(--primary);font-weight:700;font-size:17px;">Rs. <%= item.price %></span>
                        <span style="font-size:11px;color:var(--text-muted);">⏱ <%= item.preparationTime %> min</span>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    </div>
    <% }) %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function filterCat(cat, btn) {
    document.querySelectorAll('.cat-section').forEach(sec => {
        sec.style.display = (cat === 'all' || sec.dataset.category === cat) ? '' : 'none';
    });
    document.querySelectorAll('.btn-outline-secondary').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
}
</script>
</body></html>
