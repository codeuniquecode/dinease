<%- include('../partials/head', { title: 'Order from Table ' + table.tableNumber, pageStyle: 'customer' }) %>
<body>
<%- include('../partials/flash') %>

<nav class="customer-nav">
    <a href="/" class="nav-logo">🍽 DineEase</a>
    <div style="font-size:13px;color:#AAA;">
        <i class="bi bi-layout-wtf me-1"></i>Table <%= table.tableNumber %> — <%= table.location %>
    </div>
</nav>

<div style="max-width:700px;margin:0 auto;padding:24px;">
    <h2 style="font-family:'Playfair Display',serif;margin-bottom:4px;">Order from Your Table</h2>
    <p style="color:var(--text-muted);font-size:13px;margin-bottom:24px;">
        Table <%= table.tableNumber %> · <%= table.capacity %> seats · <%= table.location %>
    </p>

    <div id="cartBar" class="cart-sticky-bar" onclick="scrollToCart()">
        🛒 <span id="cartBarText">0 items</span> &nbsp;·&nbsp; <span id="cartBarTotal">Rs. 0</span>
        &nbsp;→ View cart
    </div>

    <% Object.entries(menuByCategory).forEach(([cat, items]) => { %>
    <h4 style="margin:24px 0 12px;font-size:16px;color:var(--primary);border-bottom:1px solid var(--border);padding-bottom:6px;">
        <%= cat %>
    </h4>
    <% items.forEach(item => { %>
    <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border);">
        <div style="flex:1;">
            <div style="font-weight:600;font-size:14px;"><%= item.name %></div>
            <div style="font-size:11px;color:var(--text-muted);margin-top:2px;"><%= item.description %> · ⏱ <%= item.preparationTime %> min</div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span style="font-weight:700;color:var(--primary);">Rs. <%= item.price %></span>
            <button type="button"
                onclick="addItem('<%= item._id %>','<%= item.name.replace(/'/g,`\\'`) %>',<%= item.price %>,'<%= item.category %>')"
                style="background:var(--primary);color:white;border:none;width:30px;height:30px;border-radius:50%;font-size:20px;cursor:pointer;line-height:1;display:flex;align-items:center;justify-content:center;">+</button>
        </div>
    </div>
    <% }) %>
    <% }) %>

    <!-- Cart section -->
    <div id="cartSection" style="margin-top:40px;" class="card">
        <div class="card-header d-flex justify-content-between">
            <span><i class="bi bi-cart3 me-2"></i>Your Order</span>
            <span id="cartCountBadge" class="badge" style="background:var(--primary);color:white;">0 items</span>
        </div>
        <div id="cartList">
            <div id="emptyMsg" class="cart-empty">
                <i class="bi bi-cart3" style="font-size:32px;display:block;margin-bottom:8px;color:var(--border);"></i>
                No items added yet
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between mb-3" style="font-weight:700;font-size:15px;">
                <span>Subtotal</span>
                <span id="subtotalDisplay" style="color:var(--primary);">Rs. 0</span>
            </div>
            <form id="qrOrderForm" action="/order/place" method="POST">
                <input type="hidden" name="tableId" value="<%= table._id %>">
                <input type="hidden" name="isQROrder" value="true">
                <div id="qrCartInputs"></div>
                <button type="submit" id="qrSubmitBtn" class="btn-primary-custom w-100" style="padding:12px;" disabled>
                    <i class="bi bi-send-fill me-2"></i>Place Order
                </button>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
let cart = {};

function addItem(id, name, price, category) {
    if (cart[id]) cart[id].quantity++;
    else cart[id] = { id, name, price, quantity: 1, category };
    renderCart();
}

function removeItem(id) {
    if (cart[id]) { cart[id].quantity--; if (cart[id].quantity <= 0) delete cart[id]; }
    renderCart();
}

function renderCart() {
    const items = Object.values(cart);
    const total = items.reduce((s, i) => s + i.price * i.quantity, 0);

    document.getElementById('emptyMsg').style.display = items.length === 0 ? 'block' : 'none';
    document.getElementById('subtotalDisplay').textContent = 'Rs. ' + total;
    document.getElementById('cartCountBadge').textContent = items.length + ' items';
    document.getElementById('qrSubmitBtn').disabled = items.length === 0;
    document.getElementById('cartBar').style.display = items.length > 0 ? 'block' : 'none';
    document.getElementById('cartBarText').textContent = items.length + ' item' + (items.length !== 1 ? 's' : '');
    document.getElementById('cartBarTotal').textContent = 'Rs. ' + total;

    let html = '', inputs = '';
    items.forEach((item, i) => {
        html += `<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 16px;border-bottom:1px solid var(--border);">
            <div>
                <div style="font-size:13px;font-weight:600;">${item.name}</div>
                <div style="font-size:11px;color:var(--text-muted);">Rs. ${item.price} × ${item.quantity} = Rs. ${item.price * item.quantity}</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" onclick="removeItem('${item.id}')" style="background:#EEE;border:none;width:26px;height:26px;border-radius:50%;cursor:pointer;">−</button>
                <span style="font-weight:700;min-width:18px;text-align:center;">${item.quantity}</span>
                <button type="button" onclick="addItem('${item.id}','${item.name}',${item.price},'${item.category}')" style="background:var(--primary);color:white;border:none;width:26px;height:26px;border-radius:50%;cursor:pointer;">+</button>
            </div>
        </div>`;
        inputs += `<input type="hidden" name="items[${i}][menuItemId]" value="${item.id}">
            <input type="hidden" name="items[${i}][quantity]" value="${item.quantity}">`;
    });

    if (items.length > 0) {
        document.getElementById('cartList').innerHTML = html + `<div id="emptyMsg" class="cart-empty" style="display:none;"></div>`;
    }
    document.getElementById('qrCartInputs').innerHTML = inputs;
}

function scrollToCart() {
    document.getElementById('cartSection').scrollIntoView({ behavior: 'smooth' });
}
</script>
</body></html>
