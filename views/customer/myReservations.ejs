<%- include('../partials/head', { title: 'My Reservations', pageStyle: 'customer' }) %>
<body>
<%- include('../partials/flash') %>

<nav class="customer-nav">
    <a href="/" class="nav-logo">🍽 DineEase</a>
    <div class="nav-links d-flex gap-3 align-items-center">
        <a href="/menu">Menu</a>
        <a href="/order/new">Order Food</a>
        <a href="/reserve">Reserve Table</a>
        <a href="/my-reservations" style="color:var(--primary);font-weight:600;">My Reservations</a>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <span style="color:#888;font-size:13px;border-left:1px solid #444;padding-left:12px;"><%= currentUser.name %></span>
        <a href="/logout" style="color:var(--primary);font-size:13px;">Logout</a>
        <% } %>
    </div>
</nav>

<div style="max-width:900px;margin:0 auto;padding:40px 24px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 style="font-family:'Playfair Display',serif;font-size:28px;margin:0;">My Reservations</h1>
        <a href="/reserve" class="btn-primary-custom" style="text-decoration:none;">
            <i class="bi bi-plus-circle-fill me-2"></i>New Reservation
        </a>
    </div>

    <% if (reservations.length === 0) { %>
    <div style="text-align:center;padding:60px;color:var(--text-muted);">
        <i class="bi bi-calendar-x" style="font-size:48px;display:block;margin-bottom:12px;"></i>
        <div style="font-size:16px;margin-bottom:8px;">No reservations yet</div>
        <a href="/reserve" class="btn-primary-custom" style="text-decoration:none;">Reserve a Table</a>
    </div>
    <% } else { %>
    <div class="row g-3">
        <% reservations.forEach(res => { %>
        <div class="col-md-6">
            <div class="card reservation-card status-<%= res.status %>">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <div style="font-weight:700;font-size:15px;">
                                Table <%= res.table?.tableNumber %> — <%= res.table?.location %>
                            </div>
                            <div style="font-size:12px;color:var(--text-muted);">
                                Up to <%= res.table?.capacity %> seats
                            </div>
                        </div>
                        <span class="status-badge status-<%= res.status %>"><%= res.status %></span>
                    </div>

                    <div style="font-size:13px;margin-bottom:5px;">
                        <i class="bi bi-people-fill me-2" style="color:var(--primary);"></i>
                        <strong><%= res.partySize %></strong> guests
                    </div>
                    <div style="font-size:13px;margin-bottom:5px;">
                        <i class="bi bi-calendar-event me-2" style="color:var(--primary);"></i>
                        <%= new Date(res.reservationDate).toLocaleDateString('en-NP',{weekday:'long',year:'numeric',month:'long',day:'numeric'}) %>
                    </div>
                    <div style="font-size:13px;margin-bottom:10px;">
                        <i class="bi bi-clock me-2" style="color:var(--primary);"></i>
                        <%= res.timeSlot %>
                    </div>

                    <% if (res.specialRequests) { %>
                    <div style="font-size:12px;color:var(--text-muted);font-style:italic;margin-bottom:10px;padding:8px 12px;background:var(--bg);border-radius:6px;">
                        "<%= res.specialRequests %>"
                    </div>
                    <% } %>

                    <% if (res.status === 'pending' || res.status === 'confirmed') { %>
                    <form action="/reservation/<%= res._id %>/cancel" method="POST"
                        onsubmit="return confirm('Are you sure you want to cancel this reservation?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                            <i class="bi bi-x-circle me-1"></i>Cancel Reservation
                        </button>
                    </form>
                    <% } %>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
    <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
